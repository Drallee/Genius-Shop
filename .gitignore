# Ignore everything by default.
*

# Keep the repo/project definition.
!.gitignore
!pom.xml
!README.md
!VERSION_*.md

# Keep plugin source and resources.
!src/
!src/main/
!src/main/**

# Keep documentation.
!wiki/
!wiki/**

# Keep Maven wrapper if one is added later.
!mvnw
!mvnw.cmd
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**
