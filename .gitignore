# Ignore everything by default.
*

# Keep the repo/project definition.
!.gitignore
!pom.xml
!README.md
!VERSION_*.md

# Keep plugin source and resources.
!src/
!src/main/
!src/main/**
!src/test/
!src/test/**

# Keep automated verification workflows.
!.github/
!.github/workflows/
!.github/workflows/**

# Keep local editor performance verification tools.
!tools/
!tools/preview-server.cjs
!tools/editor-rendering-check.cjs
!tools/editor-rendering.md

# Keep documentation.
!wiki/
!wiki/**

# Keep Maven wrapper if one is added later.
!mvnw
!mvnw.cmd
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**
