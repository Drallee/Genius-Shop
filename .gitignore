# Ignore everything by default.
*

# Keep the repo/project definition.
!.gitignore
!pom.xml
!README.md
!CHANGELOG.md
!VERSION_*.md

# Keep plugin source and resources.
!src/
!src/main/
!src/main/**

# Do not include tests in commits by default.
src/test/
src/test/**

# Keep documentation.
!wiki/
!wiki/**

# Keep Maven wrapper if one is added later.
!mvnw
!mvnw.cmd
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**

# Still ignore generated files inside whitelisted folders.
target/
out/
*.class
*.jar
*.war
*.zip
*.tar.gz
*.rar
*.log
*.db
*.db-shm
*.db-wal
*.bak
*.backup
*.tmp
*~

# Local editor and agent state.
.idea/
*.iml
*.ipr
*.iws
.agents/
.claude/
